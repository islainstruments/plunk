# Include only inside the existing agreed same-site origin server block.
# Substitute @LOOPBACK_PORT@ only; no hostname/DNS/catch-all change.
location = /staff/newsletters {
    proxy_pass http://127.0.0.1:@LOOPBACK_PORT@;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cache off;

    client_max_body_size 1m;
    proxy_connect_timeout 3s;
    proxy_read_timeout 12s;
}
# No health/ready/admin metadata, alternate auth, imports or sends.
location = /staff/newsletters/api/ready { return 404; }
location ^~ /staff/newsletters/ {
    proxy_pass http://127.0.0.1:@LOOPBACK_PORT@;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cache off;
    client_max_body_size 1m;
    proxy_connect_timeout 3s;
    proxy_read_timeout 12s;
}
